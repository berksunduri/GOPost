{
  "name": "GoPost",
  "outputType": "desktop",
  "debounce": 700,
  "devServer": "http://localhost:34115",
  "//_devServer": "Port must match vite.config.js server.port (34115). Keep in sync with Taskfile.yml, dev-frontend.sh, run.sh.",
  "frontend": {
    "dir": "frontend",
    "wailsjs": "frontend/src/wailsjs"
  },
  "build": {
    "appId": "com.gopost.app",
    "productName": "GoPost",
    "outputFilename": "GoPost",
    "darwin": {
      "icon": "build/darwin/icon.icns"
    },
    "windows": {
      "icon": "build/windows/icon.ico"
    },
    "linux": {
      "icon": "build/linux/icon.png"
    },
    "nsis": {
      "onlyOnLanguageSelection": false,
      "installDirectory": "$PROGRAMFILES\\GoPost"
    }
  }
}
